---
import Layout from '../../layouts/Layout.astro';
import StatBadges from '../../components/StatBadges.astro';
import Gallery from '../../components/Gallery.astro';
import RelatedPrograms from '../../components/RelatedPrograms.astro';
import { programs } from '../../data/programs.js';
import { verticals } from '../../data/site.js';
import { imagesForFolders, altFor } from '../../data/images.js';

export function getStaticPaths() {
  return programs.map((program) => ({ params: { slug: program.slug }, props: { program } }));
}

const { program } = Astro.props;
const vTitle = verticals.find((v) => v.key === program.vertical)?.title;
const images = imagesForFolders(program.folders);
const heroImg = images[0];
const galleryImages = images.slice(1);
---
<Layout title={program.title} description={program.summary}>
  <!-- Hero -->
  <section class="prog-hero">
    {heroImg && <img class="prog-hero-bg" src={heroImg} alt={altFor(program.title, 0)} />}
    <div class="prog-hero-overlay"></div>
    <div class="container prog-hero-inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <a href="/programs">Programmes</a> <span aria-hidden="true">/</span>
        <a href={`/programs#${program.vertical}`}>{vTitle}</a>
      </nav>
      <h1>{program.title}</h1>
      <p class="prog-hero-sum">{program.summary}</p>
    </div>
  </section>

  {program.review && (
    <div class="review-flag container" role="note">
      <strong>Note for review:</strong> this programme was reconstructed from archived photos and is
      not yet in the content map — please confirm the copy and figures before publishing.
    </div>
  )}

  <!-- Stats + body -->
  <section class="section">
    <div class="container prog-body-grid">
      <div class="prog-body reveal">
        <p class="eyebrow">{vTitle}</p>
        <h2>About this programme</h2>
        {program.body.map((para) => <p>{para}</p>)}
      </div>
      <aside class="prog-aside reveal">
        <h3 class="prog-aside-h">At a glance</h3>
        <StatBadges stats={program.stats} columns={1} />
        <a class="btn btn--primary prog-aside-cta" href="/partner-with-us">Partner on this programme</a>
      </aside>
    </div>
  </section>

  <!-- Gallery -->
  {galleryImages.length > 0 && (
    <section class="section section--grey">
      <div class="container">
        <div class="reveal gal-head">
          <p class="eyebrow">In pictures</p>
          <h2>Moments from the programme</h2>
        </div>
        <Gallery images={galleryImages} title={program.title} columns={3} />
      </div>
    </section>
  )}

  <RelatedPrograms current={program} />
</Layout>

<style>
  .prog-hero { position: relative; min-height: 62vh; display: flex; align-items: flex-end; overflow: hidden; }
  .prog-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .prog-hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0, 42, 74, 0.25) 0%, rgba(0, 42, 74, 0.85) 100%);
  }
  .prog-hero-inner { position: relative; z-index: 1; color: #fff; padding-block: var(--sp-6); }
  .prog-hero-inner h1 { color: #fff; max-width: 20ch; }
  .prog-hero-sum { color: rgba(255,255,255,0.90); font-size: clamp(1rem, 1.8vw, 1.25rem); max-width: 52ch; margin: 0; }
  .crumbs { font-size: 0.82rem; margin-bottom: var(--sp-2); color: rgba(255,255,255,0.82); }
  .crumbs a { color: rgba(255,255,255,0.82); }
  .crumbs a:hover { color: #fff; }

  .review-flag {
    margin-top: var(--sp-3);
    background: rgba(150, 216, 253, 0.14); /* sky-100 tint */
    border: 1px solid var(--tmf-sky-100);
    border-left: 4px solid var(--tmf-blue-400);
    border-radius: 10px;
    padding: var(--sp-2) var(--sp-3);
    font-size: 0.9rem;
    color: var(--tmf-ink);
  }

  .prog-body-grid { display: grid; grid-template-columns: 1.7fr 1fr; gap: var(--sp-5); align-items: start; }
  .prog-aside {
    position: sticky; top: calc(var(--header-h) + 16px);
    background: var(--tmf-white);
    border: 1px solid var(--tmf-grey-100);
    border-radius: var(--radius-lg);
    padding: var(--sp-3);
    box-shadow: var(--shadow);
  }
  .prog-aside-h { margin-bottom: var(--sp-2); }
  .prog-aside-cta { margin-top: var(--sp-3); width: 100%; justify-content: center; }
  .gal-head { margin-bottom: var(--sp-4); }
  @media (max-width: 860px) {
    .prog-body-grid { grid-template-columns: 1fr; gap: var(--sp-4); }
    .prog-aside { position: static; }
  }
</style>
