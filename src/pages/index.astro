---
import Layout from '../layouts/Layout.astro';
import PartnerStrip from '../components/PartnerStrip.astro';
import ProgramCard from '../components/ProgramCard.astro';
import { verticals } from '../data/site.js';
import { programs } from '../data/programs.js';
import { imagesForFolders } from '../data/images.js';

// NOTE: hero image is a placeholder — the client will supply the preferred homepage
// image via drive (flagged as ASSET NEEDED). Swap `heroImg` when it arrives.
const general = imagesForFolders(['general']);
const heroImg = general[0];

// Hero tag pills (client-supplied set).
const heroTags = [
  'CSR', 'Social Impact', 'Skill Development', 'Livelihoods', 'Employability',
  'Youth Empowerment', 'Women Empowerment', 'Healthcare', 'Digital Inclusion',
  'Community Development', 'Sustainable Development', 'Vocational Training',
  'Industry Partnerships', 'Employment', 'Inclusive Growth', 'Impact Creation',
];

// Headline impact counters (count up on scroll). `in` = Indian digit grouping.
const impactCounts = [
  { label: 'Lives Impacted', target: 252000, suffix: '+', format: 'in' },
  { label: 'Youth Skilled', target: 100000, suffix: '+', format: 'in' },
];

// Support Us pathways.
const supportCards = [
  {
    title: 'Make a Donation',
    copy: 'Empower youth with scholarships, mentorship and connections to employability.',
    href: '/contact#donate',
    cta: 'Donate →',
  },
  {
    title: 'Partner for Impact',
    copy: 'At The Ma Foi Foundation, we believe lasting change happens when purpose meets partnership. We work with organisations to design and deliver meaningful, measurable initiatives that create opportunities and strengthen communities. Let’s work together to turn your CSR vision into lasting impact.',
    href: '/contact',
    cta: 'Talk to us →',
  },
  {
    title: 'Volunteer',
    copy: 'Your time, skills and experience can help create meaningful change. Whether you mentor a young person, share your professional expertise, support a community initiative or simply lend a helping hand, your contribution can make a difference. Join The Ma Foi Foundation and be part of creating opportunities, empowering communities and building a better future.',
    href: '/volunteer',
    cta: 'Sign up to volunteer →',
  },
];

// Focus / interest areas (client-supplied set) — count in the left, tags reveal on the right.
const focusAreas = [
  'Education & Scholarships', 'Healthcare & Medical Support', 'Livelihood Creation',
  'Women’s Empowerment', 'Self-Help Groups', 'Microfinance & Enterprise Development',
  'Youth Skill Development', 'Employment & Placement', 'Digital Inclusion',
  'Industry-Aligned Training', 'Community Development', 'Child Development',
  'Rural Education', 'Women Entrepreneurship', 'Financial Inclusion',
  'Healthcare Workforce Development', 'Sports & Youth Development', 'Environmental Sustainability',
  'EV & Emerging Technology Skills', 'AI & Digital Skills', 'BFSI & Retail Skilling',
  'Vocational Training', 'Career Readiness', 'Entrepreneurship Development',
  'NGO & Community Organisation Support', 'CSR Program Implementation',
  'Industry & Institutional Partnerships', 'Scholarships & Educational Support',
  'Community Health Initiatives', 'Sustainable Livelihoods', 'Social Entrepreneurship',
  'Grassroots Development', 'Employment-Linked Skilling', 'Future Skills & Digital Transformation',
];

// Vision & Mission (replaces the former "What We Offer" pillar teaser).
const vision = 'The Ma Foi Foundation’s vision is to empower families through holistic development in education, health, and livelihoods, ultimately creating a more inclusive and equitable society. This vision is achieved by focusing on marginalized communities and providing them with comprehensive support and transformative initiatives.';
const missionLead = 'The Ma Foi Foundation, driven by “Our Society. Our Responsibility,”';
const missionPoints = [
  'To bridge the gap between talent and employment by building future-ready competencies.',
  'To collaborate with communities, institutions, and industry partners in creating equitable career pathways.',
  'To foster social and economic progress by enabling individuals to achieve dignity, self-reliance, and long-term success.',
];

// A curated set of featured programs for the home grid (one flagship per major vertical).
const featuredSlugs = ['disha-scholarship', 'ai-lab', 'ev-maintenance-training', 'bfsi-skilling', 'gda-healthcare', 'sewing-machine-operator'];
const featured = featuredSlugs.map((s) => programs.find((p) => p.slug === s)).filter(Boolean);
---
<Layout>
  <!-- HERO -->
  <section class="hero">
    {heroImg && <img class="hero-bg" src={heroImg} alt="Young trainees at a Ma Foi Foundation skilling program" />}
    <div class="hero-overlay"></div>
    <div class="container hero-inner">
      <p class="eyebrow">The CSR arm of Ma Foi CIEL HR · since 2006</p>
      <h1>Shaping Lives,<br />Strengthening Communities</h1>
      <p class="hero-sub">For over two decades, The Ma Foi Foundation has been steadfastly advancing
        inclusive and sustainable development by empowering individuals and transforming communities
        through programs in livelihood creation, healthcare, sports, environmental stewardship, skill
        development and women’s empowerment, creating pathways to dignity, opportunity and a better
        future.</p>
      <div class="hero-cta">
        <a class="btn btn--on-navy" href="#support">Support us →</a>
      </div>
      <div class="hero-tags">
        {heroTags.map((t) => <span>{t}</span>)}
      </div>
    </div>
  </section>

  <!-- OUR IMPACT + SUPPORT US (combined) -->
  <section id="support" class="section--navy section impact-support">
    <div class="container">
      <div class="impact-head reveal">
        <p class="eyebrow">See our impact</p>
        <h2>Two decades of measurable change</h2>
      </div>
      <div class="impact-counts reveal">
        {impactCounts.map((c) => (
          <div class="ic">
            <span class="ic-num countup" data-target={c.target} data-suffix={c.suffix} data-format={c.format}>0</span>
            <span class="ic-label">{c.label}</span>
          </div>
        ))}
      </div>

      <div class="support-head reveal">
        <p class="eyebrow">Support us</p>
        <h2>Three ways to create lasting change</h2>
      </div>
      <div class="support-grid">
        {supportCards.map((s) => (
          <article class="support-card reveal">
            <h3>{s.title}</h3>
            <p>{s.copy}</p>
            <a class="btn btn--on-navy support-cta" href={s.href}>{s.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FOCUS AREAS (count + staggered tags) -->
  <section class="section focus">
    <div class="container focus-grid">
      <div class="focus-count reveal">
        <span class="focus-num countup" data-target={focusAreas.length} data-suffix="+">0</span>
        <p class="focus-count-label">focus areas we work across</p>
        <p class="focus-count-sub">From scholarships and healthcare to future skills — the breadth of
          issues our programs touch every day.</p>
      </div>
      <ul class="focus-tags reveal">
        {focusAreas.map((f, i) => (
          <li style={`transition-delay:${i * 24}ms`}>{f}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- VISION & MISSION -->
  <section class="section section--grey vm">
    <div class="container vm-grid">
      <article class="vm-card reveal">
        <p class="eyebrow">Our vision</p>
        <h2>Vision</h2>
        <p>{vision}</p>
      </article>
      <article class="vm-card reveal">
        <p class="eyebrow">Our mission</p>
        <h2>Mission</h2>
        <p class="vm-lead"><strong>{missionLead}</strong></p>
        <ul class="vm-points">
          {missionPoints.map((m) => <li>{m}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <!-- FEATURED PROGRAMS -->
  <section class="section">
    <div class="container">
      <div class="reveal offer-head">
        <p class="eyebrow">Explore programs</p>
        <h2>A program for every pathway</h2>
        <p class="lead">DISHA scholarships, Centres of Excellence and skilling programs across
          {' '}{verticals.length} verticals.</p>
      </div>
      <div class="grid grid--3">
        {featured.map((p) => <ProgramCard program={p} />)}
      </div>
      <p class="offer-more reveal"><a class="btn btn--primary" href="/programs">See all programs</a></p>
    </div>
  </section>

  <!-- PARTNERS -->
  <PartnerStrip subheading="Creating lasting impact through partnerships built on shared purpose and collective action." />
</Layout>

<style>
  .hero { position: relative; min-height: 86vh; display: flex; align-items: center; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(110deg, rgba(0, 42, 74, 0.92) 0%, rgba(0, 42, 74, 0.72) 45%, rgba(0, 79, 138, 0.45) 100%);
  }
  .hero-inner { position: relative; z-index: 1; color: #fff; padding-block: var(--sp-6); }
  .hero-inner h1 { color: #fff; margin: 0 0 var(--sp-3); }
  .hero-inner .eyebrow { color: var(--tmf-sky-200); }
  .hero-sub { font-size: clamp(1rem, 1.7vw, 1.2rem); color: rgba(255,255,255,0.90); max-width: 70ch; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-3); }
  .hero-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: var(--sp-4); max-width: 74ch; }
  .hero-tags span {
    font-size: 0.78rem; font-weight: 600;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.28);
    padding: 0.35rem 0.8rem; border-radius: 999px;
  }

  /* Impact + Support */
  .impact-head, .support-head { max-width: 60ch; }
  .impact-head { margin-bottom: var(--sp-4); }
  .impact-counts {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4);
    margin-bottom: var(--sp-6);
  }
  .ic { border-left: 3px solid var(--tmf-sky-200); padding-left: var(--sp-3); }
  .ic-num {
    display: block; font-family: var(--font-head); font-weight: 800;
    font-size: clamp(2.8rem, 8vw, 5.5rem); line-height: 1; color: var(--tmf-sky-100);
    font-variant-numeric: tabular-nums;
  }
  .ic-label { display: block; margin-top: 0.5rem; font-size: 1.05rem; font-weight: 600; color: rgba(255,255,255,0.9); }

  .support-head { margin-bottom: var(--sp-4); }
  .support-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-3); }
  .support-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-lg);
    padding: var(--sp-4);
    display: flex; flex-direction: column; gap: 0.75rem;
  }
  .support-card h3 { color: #fff; margin: 0; }
  .support-card p { color: rgba(255,255,255,0.82); font-size: 0.92rem; margin: 0; flex: 1; }
  .support-cta { align-self: flex-start; margin-top: var(--sp-1); }

  /* Focus areas */
  .focus-grid { display: grid; grid-template-columns: 0.8fr 1.6fr; gap: var(--sp-5); align-items: start; }
  .focus-num {
    display: block; font-family: var(--font-head); font-weight: 800;
    font-size: clamp(3.5rem, 12vw, 7rem); line-height: 1; color: var(--tmf-blue-400);
    font-variant-numeric: tabular-nums;
  }
  .focus-count-label { font-family: var(--font-head); font-size: 1.4rem; color: var(--tmf-navy-a); margin: 0.5rem 0 var(--sp-2); }
  .focus-count-sub { color: var(--tmf-muted); font-size: 0.95rem; }
  .focus-count { position: sticky; top: calc(var(--header-h) + 20px); }
  .focus-tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .focus-tags li {
    font-size: 0.9rem; font-weight: 600; color: var(--tmf-navy-a);
    background: var(--tmf-offwhite);
    border: 1px solid var(--tmf-grey-100);
    border-radius: 999px; padding: 0.5rem 1rem;
    opacity: 0; transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .focus-tags.is-visible li { opacity: 1; transform: none; }
  .focus-tags li:hover { border-color: var(--tmf-blue-300); color: var(--tmf-blue-400); }

  /* Vision & Mission */
  .vm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); align-items: stretch; }
  .vm-card {
    background: var(--tmf-white); border: 1px solid var(--tmf-grey-100);
    border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: var(--sp-4);
  }
  .vm-lead { color: var(--tmf-navy-a); }
  .vm-points { margin: 0; padding-left: 1.1em; display: grid; gap: 0.6rem; }
  .vm-points li { color: var(--tmf-ink); }

  .offer-head { max-width: 60ch; margin-bottom: var(--sp-4); }
  .offer-more { margin-top: var(--sp-4); }

  @media (max-width: 820px) {
    .focus-grid, .vm-grid { grid-template-columns: 1fr; }
    .focus-count { position: static; }
    .support-grid { grid-template-columns: 1fr; }
    .impact-counts { grid-template-columns: 1fr; gap: var(--sp-3); margin-bottom: var(--sp-5); }
  }
</style>

<script>
  // Count-up on scroll for any .countup element. Supports Indian digit grouping (data-format="in").
  const groupIndian = (n) => {
    const s = String(n);
    if (s.length <= 3) return s;
    const last3 = s.slice(-3);
    const rest = s.slice(0, -3).replace(/\B(?=(\d{2})+(?!\d))/g, ',');
    return rest + ',' + last3;
  };
  const format = (n, mode) => (mode === 'in' ? groupIndian(n) : String(n));

  const runCount = (el) => {
    const target = Number(el.dataset.target || '0');
    const suffix = el.dataset.suffix || '';
    const mode = el.dataset.format || 'plain';
    const dur = 1400;
    let start = null;
    const step = (ts) => {
      if (start === null) start = ts;
      const p = Math.min((ts - start) / dur, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = format(Math.round(target * eased), mode) + suffix;
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  const counters = document.querySelectorAll('.countup');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || !('IntersectionObserver' in window)) {
    counters.forEach((el) => {
      const mode = el.dataset.format || 'plain';
      el.textContent = format(Number(el.dataset.target || '0'), mode) + (el.dataset.suffix || '');
    });
  } else {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { runCount(e.target); io.unobserve(e.target); }
      }
    }, { threshold: 0.4 });
    counters.forEach((el) => io.observe(el));
  }
</script>
