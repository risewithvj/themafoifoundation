---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found">
  <section class="section" style="text-align:center">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>We couldn’t find that page</h1>
      <p class="lead" style="margin-inline:auto">The page may have moved. Head back home or browse our programmes.</p>
      <p style="margin-top:var(--sp-3);display:flex;gap:var(--sp-2);justify-content:center;flex-wrap:wrap">
        <a class="btn btn--primary" href="/">Back to home</a>
        <a class="btn btn--ghost" href="/programs">All programmes</a>
      </p>
    </div>
  </section>
</Layout>
