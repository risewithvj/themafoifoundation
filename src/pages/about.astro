---
import Layout from '../layouts/Layout.astro';
import { imagesForFolders } from '../data/images.js';

const general = imagesForFolders(['general']);
const heroImg = general[0];
const storyImgs = general.slice(1, 4);

const missionLead = 'The Ma Foi Foundation, driven by “Our Society. Our Responsibility,”';
const missionPoints = [
  'To bridge the gap between talent and employment by building future-ready competencies.',
  'To collaborate with communities, institutions, and industry partners in creating equitable career pathways.',
  'To foster social and economic progress by enabling individuals to achieve dignity, self-reliance, and long-term success.',
];
---
<Layout title="About" description="The Ma Foi Foundation — the CSR arm of Ma Foi CIEL HR, creating meaningful and sustainable social impact for over two decades.">
  <section class="prog-hero about-hero">
    {heroImg && <img class="prog-hero-bg" src={heroImg} alt="A Ma Foi Foundation skilling session in progress" />}
    <div class="prog-hero-overlay"></div>
    <div class="container prog-hero-inner">
      <p class="eyebrow" style="color:var(--tmf-sky-200)">About the Foundation</p>
      <h1>Creating meaningful, sustainable social impact</h1>
      <p class="prog-hero-sum">The Ma Foi Foundation is a not-for-profit committed to creating
        opportunities, strengthening livelihoods and enabling individuals to build better futures.</p>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div class="reveal">
        <p class="eyebrow">Who we are</p>
        <h2>Empowering people, for lasting change</h2>
        <p>The Ma Foi Foundation (TMF) is a not-for-profit organisation committed to creating
          meaningful and sustainable social impact. For over two decades, we have worked alongside
          communities, institutions and corporate partners to create opportunities, strengthen
          livelihoods and enable individuals to build better futures. From education and scholarships
          to skilling, employment, healthcare and community development, our work is rooted in the
          belief that lasting change begins with empowering people.</p>
        <p>With experience across diverse communities and evolving development needs, TMF continues to
          design and implement inclusive, scalable and impact-driven initiatives that translate
          opportunities into meaningful outcomes and contribute to stronger, more resilient
          communities.</p>
        <p>Powered by the expertise of CIEL HR group, today our work spans women’s empowerment,
          next-gen technology, financial literacy, manufacturing and much more, always outcome-driven,
          always placement-first.</p>
        <p><strong>Vision ahead:</strong> outcome-driven skilling in future-ready domains, opening
          inclusive opportunities for every community we serve.</p>

        <!-- Official CIEL HR co-brand lockup (horizontal, colour) from TMF_-_Design_Guidelines.pdf -->
        <img
          class="cobrand-lockup"
          src="/images/brand/cobrand-horizontal-colour.png"
          width="1235" height="262"
          alt="The Ma Foi Foundation — powering by CIEL HR co-brand logo lockup" />
      </div>
      <div class="about-media reveal">
        {storyImgs.map((src, i) => <img src={src} alt={`The Foundation’s work in the community, photo ${i + 1}`} loading="lazy" />)}
      </div>
    </div>
  </section>

  <!-- Vision & Mission (replaces the former "Our journey" timeline) -->
  <section class="section section--grey vm">
    <div class="container">
      <div class="reveal" style="max-width:60ch;margin-bottom:var(--sp-4)">
        <p class="eyebrow">What drives us</p>
        <h2>Our vision & mission</h2>
      </div>
      <div class="vm-grid">
        <article class="vm-card reveal">
          <p class="eyebrow">Our vision</p>
          <h3>Vision</h3>
          <p>The Ma Foi Foundation’s vision is to empower families through holistic development in
            education, health, and livelihoods, ultimately creating a more inclusive and equitable
            society. This vision is achieved by focusing on marginalized communities and providing them
            with comprehensive support and transformative initiatives.</p>
        </article>
        <article class="vm-card reveal">
          <p class="eyebrow">Our mission</p>
          <h3>Mission</h3>
          <p class="vm-lead"><strong>{missionLead}</strong></p>
          <ul class="vm-points">
            {missionPoints.map((m) => <li>{m}</li>)}
          </ul>
        </article>
      </div>
    </div>
  </section>
</Layout>

<style>
  .prog-hero { position: relative; min-height: 58vh; display: flex; align-items: flex-end; overflow: hidden; }
  .prog-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .prog-hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,42,74,0.3), rgba(0,42,74,0.85)); }
  .prog-hero-inner { position: relative; z-index: 1; color: #fff; padding-block: var(--sp-6); }
  .prog-hero-inner h1 { color: #fff; max-width: 20ch; }
  .prog-hero-sum { color: rgba(255,255,255,0.90); max-width: 54ch; margin: 0; }

  .about-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--sp-5); align-items: start; }
  .about-media { display: grid; gap: var(--sp-2); grid-template-columns: 1fr 1fr; }
  .about-media img { border-radius: var(--radius); box-shadow: var(--shadow-sm); aspect-ratio: 1; object-fit: cover; width: 100%; }
  .about-media img:first-child { grid-column: 1 / -1; aspect-ratio: 16 / 9; }

  .cobrand-lockup { height: 66px; width: auto; margin-top: var(--sp-3); display: block; }

  .vm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); align-items: stretch; }
  .vm-card {
    background: var(--tmf-white); border: 1px solid var(--tmf-grey-100);
    border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); padding: var(--sp-4);
  }
  .vm-lead { color: var(--tmf-navy-a); }
  .vm-points { margin: 0; padding-left: 1.1em; display: grid; gap: 0.6rem; }
  .vm-points li { color: var(--tmf-ink); }

  @media (max-width: 820px) { .about-grid, .vm-grid { grid-template-columns: 1fr; } }
</style>
