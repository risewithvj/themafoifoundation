---
import Layout from '../layouts/Layout.astro';
import Timeline from '../components/Timeline.astro';
import Gallery from '../components/Gallery.astro';
import { imagesForFolders } from '../data/images.js';

const general = imagesForFolders(['general']);
const ddugky = imagesForFolders(['ddugky']);
const heroImg = general[0];
const storyImgs = general.slice(1, 4);
---
<Layout title="About / Our Journey" description="The Ma Foi Foundation — the CSR arm of CIEL HR, bridging the gap between skill and opportunity since 2006.">
  <section class="prog-hero about-hero">
    {heroImg && <img class="prog-hero-bg" src={heroImg} alt="A Ma Foi Foundation skilling session in progress" />}
    <div class="prog-hero-overlay"></div>
    <div class="container prog-hero-inner">
      <p class="eyebrow" style="color:var(--tmf-sky-200)">About the Foundation</p>
      <h1>Bridging the gap between skill and opportunity</h1>
      <p class="prog-hero-sum">The Ma Foi Foundation is the CSR arm of CIEL HR — a trusted skilling and
        implementation partner for corporates and institutions across India.</p>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div class="reveal">
        <p class="eyebrow">Who we are</p>
        <h2>Founded to turn potential into livelihoods</h2>
        <p>The Ma Foi Foundation, the CSR arm of CIEL HR, was established to bridge the gap between
          skill and opportunity. From our first base in Tamil Nadu in 2006, we have grown into a
          trusted implementation partner for corporates and institutions across India.</p>
        <p>Today our work spans women’s empowerment, next-gen technology, financial literacy,
          manufacturing and much more — always outcome-driven, always placement-first.</p>
        <p><strong>Vision ahead:</strong> outcome-driven skilling in future-ready domains, opening
          inclusive opportunities for every community we serve.</p>

        <!-- Official CIEL HR co-brand lockup (horizontal, colour) from TMF_-_Design_Guidelines.pdf -->
        <img
          class="cobrand-lockup"
          src="/images/brand/cobrand-horizontal-colour.png"
          width="1235" height="262"
          alt="The Ma Foi Foundation — powering by CIEL HR co-brand logo lockup" />
      </div>
      <div class="about-media reveal">
        {storyImgs.map((src, i) => <img src={src} alt={`The Foundation’s work in the community, photo ${i + 1}`} loading="lazy" />)}
      </div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container">
      <div class="reveal" style="max-width:60ch;margin-bottom:var(--sp-4)">
        <p class="eyebrow">Our journey</p>
        <h2>Two decades of purpose — 2006 to 2026</h2>
        <p class="lead">Every milestone below marks a step from a single scholarship to a Pan-India
          skilling movement.</p>
      </div>
      <Timeline />
    </div>
  </section>

  <!-- DDUGKY milestone explainer -->
  <section class="section">
    <div class="container ddugky-grid">
      <div class="reveal">
        <p class="eyebrow">National skilling missions</p>
        <h2>Joining DDUGKY, 2020</h2>
        <p>In 2020 the Foundation joined the <strong>Deen Dayal Upadhyaya Grameen Kaushalya Yojana
          (DDUGKY)</strong> — a Government of India skilling mission focused on rural youth. It is a
          formal government mission rather than a single programme, and marks our step into
          large-scale, nationally-backed livelihood skilling.</p>
        <p>This partnership deepened our reach into underserved communities and strengthened our
          placement-linked delivery model.</p>
      </div>
      <div class="reveal">
        <Gallery images={ddugky} title="DDUGKY skilling mission" columns={2} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .prog-hero { position: relative; min-height: 58vh; display: flex; align-items: flex-end; overflow: hidden; }
  .prog-hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .prog-hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,42,74,0.3), rgba(0,42,74,0.85)); }
  .prog-hero-inner { position: relative; z-index: 1; color: #fff; padding-block: var(--sp-6); }
  .prog-hero-inner h1 { color: #fff; max-width: 18ch; }
  .prog-hero-sum { color: rgba(255,255,255,0.90); max-width: 54ch; margin: 0; }

  .about-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--sp-5); align-items: start; }
  .about-media { display: grid; gap: var(--sp-2); grid-template-columns: 1fr 1fr; }
  .about-media img { border-radius: var(--radius); box-shadow: var(--shadow-sm); aspect-ratio: 1; object-fit: cover; width: 100%; }
  .about-media img:first-child { grid-column: 1 / -1; aspect-ratio: 16 / 9; }

  .cobrand-lockup { height: 66px; width: auto; margin-top: var(--sp-3); display: block; }

  .ddugky-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-5); align-items: center; }
  @media (max-width: 820px) { .about-grid, .ddugky-grid { grid-template-columns: 1fr; } }
</style>
