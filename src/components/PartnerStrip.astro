---
import { partners } from '../data/site.js';
const { heading = 'Our Partners & CSR Collaborators', subheading = '' } = Astro.props;
// Marquee scales gracefully whether there are 15 or 30 logos. The track is duplicated so the
// scroll loops seamlessly; prefers-reduced-motion falls back to a static wrapped row.
const loop = [...partners, ...partners];
---
<section class="section section--grey partners">
  <div class="container">
    <div class="partners-head reveal">
      <p class="eyebrow">Trusted collaborations</p>
      <h2>{heading}</h2>
      {subheading && <p class="lead">{subheading}</p>}
    </div>
  </div>
  <div class="marquee" role="list" aria-label="Partner organisations">
    <ul class="marquee-track" aria-hidden="false">
      {loop.map((p, i) => (
        <li class={`partner-card ${i >= partners.length ? 'is-dupe' : ''}`} role="listitem" aria-hidden={i >= partners.length ? 'true' : 'false'}>
          <img src={`/images/partners/${p.slug}.png`} alt={`${p.name} logo`} loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .partners-head { text-align: center; max-width: 60ch; margin: 0 auto var(--sp-4); }
  .partners-head .lead { margin-inline: auto; }

  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee-track {
    list-style: none; margin: 0; padding: 0;
    display: flex; gap: var(--sp-2); width: max-content;
    animation: marquee 48s linear infinite;
  }
  .marquee:hover .marquee-track { animation-play-state: paused; }

  .partner-card {
    flex: none;
    width: 200px;
    background: var(--tmf-white);
    border: 1px solid var(--tmf-grey-100);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-3);
    min-height: 96px;
  }
  .partner-card img { max-height: 52px; width: auto; object-fit: contain; }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* No motion → static, centered wrapping row (still shows every logo once). */
  @media (prefers-reduced-motion: reduce) {
    .marquee { -webkit-mask-image: none; mask-image: none; }
    .marquee-track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; padding-inline: var(--sp-3); }
    .partner-card.is-dupe { display: none; } /* hide the duplicated half */
  }
</style>
