# Copy this file to .env.local for local dev (never commit the real .env.local)
# In production, set these in Vercel: Project → Settings → Environment Variables

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# Supabase SERVICE ROLE key (secret, server-side only — never the anon key here)
SUPABASE_SERVICE_KEY=

# Supabase ANON (public) key — used by /api/config and /api/admin-login.
# Safe to expose to the browser, but kept in env so it is not hardcoded.
SUPABASE_ANON_KEY=

# Any long random string, used to sign the numeric captcha challenges
# Generate one with: openssl rand -hex 32
CAPTCHA_SECRET=
